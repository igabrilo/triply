FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database: use one of the options below
# Option A (Docker): run `docker compose up db -d` first
DATABASE_URL=postgresql://triply:triply_dev@localhost:5432/triply

# Option B (local PostgreSQL): create role/db with `psql -U postgres -f backend/scripts/init_db.sql`
# DATABASE_URL=postgresql://triply:triply_dev@localhost:5432/triply

# Option C (use postgres superuser): run `createdb triply` then:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triply

CORS_ORIGINS=http://localhost:3000

# OpenAI – required for trip generation and chat edits
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_GENERATION=gpt-5.2
OPENAI_MODEL_CHAT=gpt-5-mini

# Google Maps (optional) – enables real lat/lng geocoding for plan items
# Without this, plan items still get Google Maps search URLs but no coordinates
GOOGLE_MAPS_API_KEY=

# Runtime feature flags (served via GET /api/feature-flags)
FEATURE_FIRST_PLAN_GUIDE=true
FEATURE_NEXT_BEST_ACTIONS=true
FEATURE_ACTIVATION_ANALYTICS=true

