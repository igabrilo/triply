# API URL - use /api to go through Vite proxy (recommended)
VITE_API_URL=/api

# Proxy target for Vite dev server (used when VITE_API_URL=/api)
# For Docker: http://backend:5000
# For local dev: http://localhost:5001
VITE_PROXY_TARGET=http://localhost:5001

# Optional local defaults (runtime backend flags can override these)
VITE_FEATURE_FIRST_PLAN_GUIDE=true
VITE_FEATURE_NEXT_BEST_ACTIONS=true
VITE_FEATURE_ACTIVATION_ANALYTICS=true
